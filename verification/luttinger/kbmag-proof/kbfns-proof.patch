+/* Machine-readable additions to -ve output.  These retain the information
+ * that upstream KBMAG normally loses when tidyup changes and compacts its
+ * numbered equation array. */
+static void proof_word(gen *w)
+{
+  boolean first = TRUE;
+  printf("[");
+  while (*w != '\0') {
+    if (!first)
+      printf(",");
+    printf("%d", (int)*(w++));
+    first = FALSE;
+  }
+  printf("]");
+}
