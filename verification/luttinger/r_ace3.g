.1^-1*F.2^-1*F.1^-1*F.2^-1*F.1^-1*F.3*F.1^-1*F.3^-1*F.1*F.1*F.2*F.1^-1*F.3*F.1*F.2*F.1*F.2^-1*F.3^-1*F.1^-1*F.3*F.1^-1*F.3^-1*F.1*F.1*F.2^-1*F.1^-1*F.1^-1*F.3*F.1*F.3^-1*F.1*F.2*F.1*F.2*F.1*F.2^-1*F.1^-1*F.1^-1*F.3*F.1*F.2*F.1^-1*F.2^-1,F.1*F.2*F.1^-1*F.3*F.1*F.3^-1*F.1*F.3^-1*F.1*F.3*F.1^-1*F.2^-1*F.1^-1*F.3^-1*F.1^-1*F.3*F.1^-1*F.3*F.1^-1*F.3^-1*F.1*F.1,F.3*F.1^-1*F.3^-1*F.1*F.1*F.2*F.1^-1*F.1^-1*F.3*F.1*F.3^-1*F.1*F.1*F.3^-1*F.1*F.3*F.1^-1*F.2^-1*F.1^-1*F.3^-1*F.1^-1*F.3];;
mua := F.1^-1*F.1^-1*F.3*F.1*F.3^-1*F.1*F.3^-1*F.1*F.3;;
lfa := F.2^-1*F.1*F.2*F.1;;
lba1 := F.2;;
lba2 := F.1*F.2*F.1;;
mub := F.1^-1*F.1^-1*F.3*F.1*F.3^-1*F.1*F.2^-1*F.1^-1*F.2^-1*F.1^-1*F.3*F.1^-1*F.3^-1*F.1*F.1*F.2*F.1^-1*F.1^-1*F.3*F.1*F.3^-1*F.1*F.3*F.1^-1*F.3^-1*F.1*F.1*F.2;;
lfb := F.1^-1*F.1^-1*F.3*F.1*F.3^-1*F.1*F.3*F.1^-1*F.3^-1*F.1*F.1;;
lbb := F.1^-1*F.2^-1*F.1^-1*F.1^-1*F.3*F.1*F.2*F.1*F.3^-1*F.1^-1*F.3*F.1^-1*F.3*F.1^-1*F.3^-1*F.1*F.1;;
for lba in [lba1, lba2] do
  Q := F/Concatenation(rels,[mua^2*lba^-1, mub^2*lbb^-1]);
  S := SimplifiedFpGroup(Q);
  fg := FreeGeneratorsOfFpGroup(S);; rl := RelatorsOfFpGroup(S);;
  Print("drift ", Position([lba1,lba2],lba), ": simplified to ",
        Length(fg), " gens, total len ", Sum(rl, Length), "\n");
  st := ACEStats(fg, rl, [] : felsch := true, workspace := 100000000);;
  Print("  ACE felsch: index ", st.index, " tot ", st.totcosets, "\n");
  if st.index = 0 then
    st := ACEStats(fg, rl, [] : hard, workspace := 100000000);;
    Print("  ACE hard: index ", st.index, " tot ", st.totcosets, "\n");
  fi;
  if st.index = 0 then
    Lw := LowIndexSubgroupsFpGroup(S, 8);;
    Print("  low-index<=8: ", List(Lw, u -> Index(S,u)), "\n");
    Print("  epis onto A5: ", Length(GQuotients(S, AlternatingGroup(5))), "\n");
  fi;
od;
QUIT;;
