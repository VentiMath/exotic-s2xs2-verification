# T_alpha
LoadPackage("kbmag");;
F := FreeGroup(49);;
rels := [F.31*F.13^-1,F.16*F.48^-1,F.19*F.39^-1,F.31,F.21*F.5*F.40^-1,F.23*F.25^-1,F.35^-1,F.1*F.14^-1,F.43*F.24*F.8^-1,F.21*F.46^-1,F.4*F.5,F.2,F.19*F.3,F.18*F.44*F.24^-1,F.3^-1,F.42*F.28*F.14^-1,F.47*F.33^-1,F.26^-1,F.20*F.32^-1,F.29*F.22*F.18^-1,F.36*F.41*F.8^-1,F.2*F.27^-1,F.9*F.37*F.40^-1,F.6*F.45^-1,F.6*F.36,F.16*F.11^-1,F.47*F.27^-1,F.17*F.30^-1,F.48^-1,F.10*F.44*F.25^-1,F.10*F.33^-1,F.22*F.34^-1,F.20*F.35^-1,F.7*F.9*F.32^-1,F.15*F.13^-1,F.42*F.17,F.49,F.28,F.38^-1,F.37*F.41*F.26^-1,F.12*F.4*F.30^-1,F.43*F.11^-1,F.49*F.45^-1,F.15*F.34^-1,F.1*F.23*F.39^-1,F.29*F.7*F.38^-1,F.46^-1,F.12];;
