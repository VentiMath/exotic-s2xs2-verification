# edge-path group of the p-section of the real audit bundle K (extract_section.py), based at q
edges := [[1, 2], [1, 4], [1, 5], [1, 7], [1, 8], [1, 82], [2, 3], [2, 5], [2, 6], [2, 8], [2, 9], [3, 6], [3, 9], [3, 10], [3, 11], [4, 5], [4, 7], [4, 8], [4, 82], [4, 83], [5, 6], [5, 8], [5, 9], [6, 9], [6, 11], [6, 12], [7, 8], [7, 83], [7, 84], [8, 9], [9, 12], [10, 11], [10, 43], [10, 44], [11, 12], [11, 44], [11, 45], [12, 45], [13, 14], [13, 16], [13, 17], [13, 100], [14, 15], [14, 17], [14, 18], [14, 100], [14, 101], [15, 18], [15, 101], [15, 102], [16, 17], [16, 19], [16, 20], [17, 18], [17, 20], [17, 21], [18, 21], [19, 20], [19, 22], [19, 23], [20, 21], [20, 23], [20, 24], [21, 24], [22, 23], [22, 25], [22, 26], [23, 24], [23, 26], [23, 27], [24, 27], [25, 26], [25, 28], [25, 29], [26, 27], [26, 29], [26, 30], [27, 30], [28, 29], [28, 31], [28, 32], [29, 30], [29, 32], [29, 33], [30, 33], [31, 32], [31, 34], [31, 35], [32, 33], [32, 35], [32, 36], [33, 36], [34, 35], [34, 37], [34, 38], [35, 36], [35, 38], [35, 39], [36, 39], [37, 38], [37, 40], [37, 41], [38, 39], [38, 41], [38, 42], [39, 42], [40, 41], [40, 46], [40, 47], [41, 42], [41, 47], [41, 48], [42, 48], [43, 44], [43, 76], [43, 77], [44, 45], [44, 77], [44, 78], [45, 78], [46, 47], [46, 49], [46, 50], [47, 48], [47, 50], [47, 51], [48, 51], [49, 50], [49, 52], [49, 53], [50, 51], [50, 53], [50, 54], [51, 54], [52, 53], [52, 55], [52, 56], [53, 54], [53, 56], [53, 57], [54, 57], [55, 56], [55, 58], [55, 59], [56, 57], [56, 59], [56, 60], [57, 60], [58, 59], [58, 61], [58, 62], [59, 60], [59, 62], [59, 63], [60, 63], [61, 62], [61, 64], [61, 65], [62, 63], [62, 65], [62, 66], [63, 66], [64, 65], [64, 67], [64, 68], [65, 66], [65, 68], [65, 69], [66, 69], [67, 68], [67, 70], [67, 71], [68, 69], [68, 71], [68, 72], [69, 72], [70, 71], [70, 73], [70, 74], [71, 72], [71, 74], [71, 75], [72, 75], [73, 74], [73, 79], [73, 80], [74, 75], [74, 80], [74, 81], [75, 81], [76, 77], [76, 85], [76, 86], [77, 78], [77, 86], [77, 87], [78, 87], [79, 80], [79, 82], [79, 83], [80, 81], [80, 83], [80, 84], [81, 84], [82, 83], [83, 84], [85, 86], [85, 88], [85, 89], [86, 87], [86, 89], [86, 90], [87, 90], [88, 89], [88, 91], [88, 92], [89, 90], [89, 92], [89, 93], [90, 93], [91, 92], [91, 94], [91, 95], [92, 93], [92, 95], [92, 96], [93, 96], [94, 95], [94, 97], [94, 98], [95, 96], [95, 98], [95, 99], [96, 99], [97, 98], [97, 100], [97, 101], [98, 99], [98, 101], [98, 102], [99, 102], [100, 101], [101, 102]];;
faces := [[1, 2, 8], [29, 32, 33], [77, 78, 87], [5, 6, 9], [47, 50, 51], [98, 101, 102], [13, 16, 17], [91, 92, 95], [26, 29, 30], [50, 51, 54], [86, 87, 90], [71, 72, 75], [20, 21, 24], [25, 26, 29], [43, 76, 77], [26, 27, 30], [4, 5, 8], [94, 95, 98], [73, 74, 80], [31, 34, 35], [2, 3, 9], [32, 33, 36], [76, 85, 86], [79, 82, 83], [13, 14, 100], [15, 101, 102], [44, 77, 78], [70, 73, 74], [13, 14, 17], [77, 86, 87], [89, 92, 93], [22, 23, 26], [91, 94, 95], [2, 3, 6], [11, 12, 45], [10, 11, 44], [25, 28, 29], [16, 17, 20], [38, 41, 42], [61, 64, 65], [55, 56, 59], [3, 10, 11], [4, 82, 83], [80, 81, 84], [29, 30, 33], [70, 71, 74], [52, 55, 56], [95, 96, 99], [49, 50, 53], [68, 69, 72], [17, 18, 21], [34, 37, 38], [52, 53, 56], [43, 44, 77], [64, 65, 68], [47, 48, 51], [7, 83, 84], [14, 100, 101], [80, 83, 84], [37, 40, 41], [14, 15, 101], [56, 57, 60], [55, 58, 59], [49, 52, 53], [23, 24, 27], [59, 60, 63], [74, 80, 81], [1, 7, 8], [65, 68, 69], [62, 65, 66], [4, 7, 83], [73, 79, 80], [22, 25, 26], [67, 70, 71], [88, 89, 92], [71, 74, 75], [97, 98, 101], [35, 38, 39], [74, 75, 81], [41, 42, 48], [16, 19, 20], [76, 77, 86], [14, 15, 18], [40, 46, 47], [20, 23, 24], [2, 5, 6], [58, 61, 62], [35, 36, 39], [98, 99, 102], [59, 62, 63], [53, 56, 57], [1, 4, 5], [50, 53, 54], [4, 7, 8], [19, 20, 23], [79, 80, 83], [28, 29, 32], [44, 45, 78], [34, 35, 38], [1, 2, 5], [6, 9, 12], [38, 39, 42], [11, 44, 45], [3, 6, 11], [95, 98, 99], [88, 91, 92], [85, 86, 89], [64, 67, 68], [28, 31, 32], [97, 100, 101], [31, 32, 35], [68, 71, 72], [94, 97, 98], [56, 59, 60], [5, 8, 9], [14, 17, 18], [46, 47, 50], [40, 41, 47], [1, 4, 82], [41, 47, 48], [65, 66, 69], [19, 22, 23], [86, 89, 90], [85, 88, 89], [10, 43, 44], [6, 11, 12], [89, 90, 93], [92, 93, 96], [61, 62, 65], [37, 38, 41], [17, 20, 21], [58, 59, 62], [32, 35, 36], [53, 54, 57], [2, 8, 9], [92, 95, 96], [62, 63, 66], [46, 49, 50], [23, 26, 27], [67, 68, 71]];;
paths := rec(alpha := [3, 6, 9, 3], beta := [3, 6, 11, 44, 77, 86, 89, 92, 95, 98, 101, 14, 17, 20, 23, 26, 29, 32, 35, 38, 41, 47, 50, 53, 56, 59, 62, 65, 68, 71, 74, 80, 83, 4, 5, 6, 3], bdry := [3, 9, 12, 45, 78, 87, 90, 93, 96, 99, 102, 15, 18, 21, 24, 27, 30, 33, 36, 39, 42, 48, 51, 54, 57, 60, 63, 66, 69, 72, 75, 81, 84, 7, 1, 82, 79, 73, 70, 67, 64, 61, 58, 55, 52, 49, 46, 40, 37, 34, 31, 28, 25, 22, 19, 16, 13, 100, 97, 94, 91, 88, 85, 76, 43, 10, 3]);;
nv := 102;;
Print("V=", nv, " E=", Length(edges), " F=", Length(faces), " chi=", nv-Length(edges)+Length(faces), "\n");
Fr := FreeGroup(Length(edges));; g := GeneratorsOfGroup(Fr);;
epos := NewDictionary([1,2], true);; for i in [1..Length(edges)] do AddDictionary(epos, edges[i], i); od;
edgeElt := function(u, v) local p; p := LookupDictionary(epos, [u,v]); if p <> fail then return g[p]; fi; p := LookupDictionary(epos, [v,u]); return g[p]^-1; end;;
pathElt := function(path) local w, t; w := One(Fr); for t in [1..Length(path)-1] do w := w*edgeElt(path[t], path[t+1]); od; return w; end;;
rels := List(faces, f -> pathElt(Concatenation(f, [f[1]])));;
cnt := ListWithIdenticalEntries(Length(edges), 0);; for f in faces do for pr in [[1,2],[2,3],[1,3]] do p := LookupDictionary(epos, [f[pr[1]], f[pr[2]]]); cnt[p] := cnt[p]+1; od; od;
free := Filtered([1..Length(edges)], p -> cnt[p] = 1);; Print("free edges: ", Length(free), "\n");
bd := Set(List([1..Length(paths.bdry)-1], t -> LookupDictionary(epos, SortedList([paths.bdry[t], paths.bdry[t+1]]))));;
Print("boundary path uses exactly the free edges: ", bd = Set(free), "\n");
q := 3;; seen := [q];; queue := [q];; tree := [];;
while Length(queue) > 0 do u := Remove(queue, 1); for e in edges do if e[1] = u and not e[2] in seen then Add(tree, e); Add(seen, e[2]); Add(queue, e[2]); fi; if e[2] = u and not e[1] in seen then Add(tree, e); Add(seen, e[1]); Add(queue, e[1]); fi; od; od;
Print("spanning tree reaches all vertices: ", Length(seen) = nv, "\n");
Append(rels, List(tree, e -> g[LookupDictionary(epos, e)]));;
G := Fr / rels;; iso := IsomorphismSimplifiedFpGroup(G);; H := Range(iso);;
Print("pi_1(section) simplified: ", Length(GeneratorsOfGroup(H)), " generators, ", Length(RelatorsOfFpGroup(H)), " relators\n");
toG := GroupHomomorphismByImages(Fr, G, g, GeneratorsOfGroup(G));; img := w -> Image(iso, Image(toG, w));;
alphaP := img(pathElt(paths.alpha));; betaP := img(pathElt(paths.beta));; bdry := img(pathElt(paths.bdry));;
A := alphaP^-1;; B := betaP^-1;;
Print("alpha_positive = ", alphaP, "\nbeta_positive  = ", betaP, "\nboundary       = ", bdry, "\n");
cands := rec(AiBiAB := A^-1*B^-1*A*B, BiABAi := B^-1*A*B*A^-1, ABAiBi := A*B*A^-1*B^-1, BAiBiA := B*A^-1*B^-1*A, BiAiBA := B^-1*A^-1*B*A, AiBABi := A^-1*B*A*B^-1, BABiAi := B*A*B^-1*A^-1, ABiAiB := A*B^-1*A^-1*B);;
for n in RecNames(cands) do if cands.(n) = bdry then Print("boundary loop at q = ", n, " (in A, B)\n"); fi; if cands.(n) = bdry^-1 then Print("boundary loop at q = (", n, ")^-1 (in A, B)\n"); fi; od;
Print("A, B generate pi_1(section): ", Index(H, Subgroup(H, [A, B])) = 1, "\n");
