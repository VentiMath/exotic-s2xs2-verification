F:=FreeGroup("x","y","r","s","A","B","M","N");; g:=GeneratorsOfGroup(F);;
W:=function(l) local w,i; w:=One(F); for i in l do if i>0 then w:=w*g[i]; else w:=w*g[-i]^-1; fi; od; return w; end;;
sheet:=List([[5, 1, -5, -3], [5, 2, -5, -4], [5, 3, -5, -1], [5, 4, -5, -2, -8], [6, 2, -6, -1, -2, 7], [6, 3, -6, -3], [6, 4, -6, -4, -3, 7, 3], [1, 2, -1, -2, 3, 4, -3, -4], [-5, 3, 5, -1], [4, 5, -2, -5], [6, -3, -6, 3], [5, 7, -1, -5, -7, 3], [1, 7, -5, -3, -7, 5], [-7, 5, -3, 7, 3, -5], [7, 6, 2, -6, -1, -2], [4, -6, -4, -3, 7, 6, 3], [1, 7, 6, -2, -1, 4, -6, -4], [-3, 6, 5, 1, 3, -5, 2, -6, -1], [2, -6, -1, 6, 1, 5, -2, -1, -5, 3, 4], [4, 3, -4, -3, -8, 5, 4, -5, 1, -2, -1], [4, -3, -4, -3, 5, 1, 2, 1, -2, -1, -5, 3], [1, 2, 1, -2, -1, -3, 5, 1, 2, 1, -2, -1, -3, -5], [3, 4, 5, -6, -1, -5, -7, 2, 3, 5, 6, -5, -4, -3, -2], [7, 6, 5, 1, 2, 1, -2, -1, -5, -6, -7, -5, 1, 2, -1, -2, -1, 5], [-3, 5, 1, 2, 1, -2, -1, -3, 2, 1, -2, -1, -5, 2, -6, 1, 6, -2, 1, -2, -1], [-3, -6, -7, 5, 5, 7, 3, -5, 3, -5, 6, -2, -1], [6, 1, -6, -7, 2], [6, -4, -3, 2, 1, -6, -7, -1, 4, 3], [7, 5, 1, -7, -1, -5], [-5, 8, 5, -3, 7, 3, 6, -5, -8, 5, -6, -3, -7, 3]], W);;
M:=g[7];; B:=g[6];;
rels:=Concatenation(sheet, List([[7, 5, 1],[-5, 8, 5, -3, 7, 3, 6]], W));;
t:=CosetTableFromGensAndRels(g, rels, []:max:=200000, silent:=true);; if t=fail then Print("honest_y1_p1_p1 without MB: overflow at 200000 (expected)\n"); else Print("honest_y1_p1_p1 without MB: INDEX ", Length(t[1]), "\n"); fi;
t:=CosetTableFromGensAndRels(g, Concatenation(rels,[M*B]), []:max:=3000000, silent:=true);; if t=fail then Print("honest_y1_p1_p1 with MB=1: OVERFLOW\n"); else Print("honest_y1_p1_p1 with MB=1: INDEX ", Length(t[1]), "\n"); fi;
t:=CosetTableFromGensAndRels(g, Concatenation(rels,[Comm(B,M)]), []:max:=3000000, silent:=true);; if t=fail then Print("honest_y1_p1_p1 with [B,M]=1: OVERFLOW\n"); else Print("honest_y1_p1_p1 with [B,M]=1: INDEX ", Length(t[1]), "\n"); fi;
