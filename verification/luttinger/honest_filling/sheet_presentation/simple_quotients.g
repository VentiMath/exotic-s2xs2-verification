it := SimpleGroupsIterator(60, 1000000);;
for S in it do
  Print("simple ", StructureDescription(S), " order ", Size(S), ":");
  for c in cases do
    q := GQuotients(c[2], S);
    if Length(q) > 0 then Print(" *** ", c[1], " HAS ", Length(q), " EPIMORPHISMS ***"); fi;
  od;
  Print(" done\n");
od;
Print("SWEEP COMPLETE\n");
QUIT;

