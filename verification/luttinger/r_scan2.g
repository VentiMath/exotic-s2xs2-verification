.1^-1*F.2^-1*F.1^-1*F.2^-1*F.1^-1*F.3*F.1^-1*F.3^-1*F.1*F.1*F.2*F.1^-1*F.3*F.1*F.2*F.1*F.2^-1*F.3^-1*F.1^-1*F.3*F.1^-1*F.3^-1*F.1*F.1*F.2^-1*F.1^-1*F.1^-1*F.3*F.1*F.3^-1*F.1*F.2*F.1*F.2*F.1*F.2^-1*F.1^-1*F.1^-1*F.3*F.1*F.2*F.1^-1*F.2^-1,F.1*F.2*F.1^-1*F.3*F.1*F.3^-1*F.1*F.3^-1*F.1*F.3*F.1^-1*F.2^-1*F.1^-1*F.3^-1*F.1^-1*F.3*F.1^-1*F.3*F.1^-1*F.3^-1*F.1*F.1,F.3*F.1^-1*F.3^-1*F.1*F.1*F.2*F.1^-1*F.1^-1*F.3*F.1*F.3^-1*F.1*F.1*F.3^-1*F.1*F.3*F.1^-1*F.2^-1*F.1^-1*F.3^-1*F.1^-1*F.3];;
mua := F.1^-1*F.1^-1*F.3*F.1*F.3^-1*F.1*F.3^-1*F.1*F.3;;
lfa := F.2^-1*F.1*F.2*F.1;;
lba1 := F.2;;
lba2 := F.1*F.2*F.1;;
mub := F.1^-1*F.1^-1*F.3*F.1*F.3^-1*F.1*F.2^-1*F.1^-1*F.2^-1*F.1^-1*F.3*F.1^-1*F.3^-1*F.1*F.1*F.2*F.1^-1*F.1^-1*F.3*F.1*F.3^-1*F.1*F.3*F.1^-1*F.3^-1*F.1*F.1*F.2;;
lfb := F.1^-1*F.1^-1*F.3*F.1*F.3^-1*F.1*F.3*F.1^-1*F.3^-1*F.1*F.1;;
lbb := F.1^-1*F.2^-1*F.1^-1*F.1^-1*F.3*F.1*F.2*F.1*F.3^-1*F.1^-1*F.3*F.1^-1*F.3*F.1^-1*F.3^-1*F.1*F.1;;
probe := function(w1, w2, tag)
  local Q, S, tab;
  Q := F/Concatenation(rels,[w1, w2]);
  if Length(AbelianInvariants(Q)) > 0 then
    Print(tag, ": H1 nonzero\n"); return;
  fi;
  S := SimplifiedFpGroup(Q);
  if Length(FreeGeneratorsOfFpGroup(S)) = 0 then
    Print(tag, ": TRIVIAL (Tietze)\n"); return;
  fi;
  tab := CosetTableFromGensAndRels(FreeGeneratorsOfFpGroup(S),
           RelatorsOfFpGroup(S), [] : max := 1000000, silent := true);
  if tab = fail then Print(tag, ": overflow\n");
  elif Length(tab[1]) = 1 then Print(tag, ": TRIVIAL\n");
  else Print(tag, ": |G| = ", Length(tab[1]), "\n"); fi;
end;;
# hypothesis: lambda_true = lambda_machine * mu^-1 on both tori.
# then mu*lambda_true^(+1) = mu*l*mu^-1  and  mu*lambda_true^(-1) = mu^2*l^-1.
wa := function(l, e)
  if e = 1 then return mua*l*mua^-1; else return mua^2*l^-1; fi; end;;
wb := function(e)
  if e = 1 then return mub*lbb*mub^-1; else return mub^2*lbb^-1; fi; end;;
for lba in [lba1, lba2] do
  for eA in [1,-1] do for eB in [1,-1] do
    probe(wa(lba, eA), wb(eB),
      Concatenation("drift=", String(Position([lba1,lba2],lba)),
                    " (", String(eA), ",", String(eB), ")"));
  od; od;
od;
QUIT;;
