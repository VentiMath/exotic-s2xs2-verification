att := CALL_WITH_CATCH(KnuthBendix,[rws]);;
conf := IsConfluent(rws);;
allone := ForAll(GeneratorsOfGroup(FreeStructureOfRewritingSystem(rws)), z -> IsOne(ReducedForm(rws,z)));;
Print("KB=",att," confluent=",conf," gens_to_id=",allone,"\n");
if conf and allone then
  WriteRWS(rws, "j_certificates/n1_y2_ap1_bm1_jap2_jbp0_confluent.rws");
  Print("VERDICT certified_trivial_kb\n");
fi;
QUIT;;
