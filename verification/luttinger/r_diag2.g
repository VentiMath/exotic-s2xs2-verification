Print("gens: ", FreeGeneratorsOfFpGroup(S), "\n");
Print("rels: ", RelatorsOfFpGroup(S), "\n");
Lw := LowIndexSubgroupsFpGroup(S, 10);;
Print("subgroups of index <= 10: ", List(Lw, u -> Index(S,u)), "\n");
for T in [AlternatingGroup(5), PSL(2,7), AlternatingGroup(6), PSL(2,8)] do
  q := GQuotients(S, T);
  Print("epis onto ", StructureDescription(T), ": ", Length(q), "\n");
od;
QUIT;;
