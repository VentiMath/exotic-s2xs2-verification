G := F/rels;;
iso := IsomorphismSimplifiedFpGroup(G);; H := Image(iso);;
fg := FreeGeneratorsOfFpGroup(H);; rl := RelatorsOfFpGroup(H);;
Print("simplified=",Length(fg)," gens\n");
if Length(fg)=0 then
  Print("VERDICT certified_trivial_tietze\n");
else
  acecall := function() return ACEStats(fg,rl,[] : hard, workspace := 50000000); end;;
  att := CALL_WITH_CATCH(acecall,[]);;
  if att[1]=true then
    Print("ACE index=",att[2].index," totcosets=",att[2].totcosets,"\n");
  else
    Print("ACE failed\n");
  fi;
  if att[1]=true and att[2].index=1 then
    Print("VERDICT certified_trivial_ace\n");
  else
    targets := [AlternatingGroup(5),PSL(2,7),AlternatingGroup(6),PSL(2,8),PSL(2,11),PSL(2,13)];;
    found := false;;
    for target in targets do
      epis := GQuotients(H,target);;
      Print("quotients ",Size(target),": ",Length(epis),"\n");
      if Length(epis)>0 then found := true; fi;
    od;
    subs := LowIndexSubgroupsFpGroup(H,8);;
    Print("low_index_subgroups<=8: ",Length(subs),"\n");
    if found or Length(subs)>1 then
      Print("VERDICT nontrivial_witness\n");
    else
      Print("VERDICT inconclusive\n");
    fi;
  fi;
fi;
QUIT;;
