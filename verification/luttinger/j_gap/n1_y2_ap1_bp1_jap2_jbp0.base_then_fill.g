ab := AbelianInvariants(H);;
Print("H1=",ab,"\n");
fg := FreeGeneratorsOfFpGroup(H);; rl := RelatorsOfFpGroup(H);;
Print("simplified=",Length(fg)," gens/",Length(rl)," rels total_length=",Sum(rl,Length),"\n");
if ab <> [] then
  Print("VERDICT nontrivial_h1\n");
elif Length(fg)=0 then
  Print("VERDICT certified_trivial_tietze\n");
else
  rws := KBMAGRewritingSystem(H);;
  attempt := CALL_WITH_CATCH(KnuthBendix,[rws]);;
  conf := IsConfluent(rws);;
  reds := List(GeneratorsOfGroup(FreeStructureOfRewritingSystem(rws)), z -> ReducedForm(rws,z));;
  allone := ForAll(reds,IsOne);;
  ok := attempt=[true,true] and conf and allone;;
  Print("KB=",attempt," confluent=",conf," generators_to_identity=",allone,"\n");
  if ok then
    WriteRWS(rws,"j_rws/n1_y2_ap1_bp1_jap2_jbp0.rws");
    Print("VERDICT certified_trivial_kb\n");
  else
    Print("VERDICT inconclusive\n");
  fi;
fi;
QUIT;;
