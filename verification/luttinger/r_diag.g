mua := F.1^-1*F.1^-1*F.3*F.1*F.3^-1*F.1*F.3^-1*F.1*F.3;;
lfa := F.2^-1*F.1*F.2*F.1;;
lba1 := F.2;;
lba2 := F.1*F.2*F.1;;
mub := F.1^-1*F.1^-1*F.3*F.1*F.3^-1*F.1*F.2^-1*F.1^-1*F.2^-1*F.1^-1*F.3*F.1^-1*F.3^-1*F.1*F.1*F.2*F.1^-1*F.1^-1*F.3*F.1*F.3^-1*F.1*F.3*F.1^-1*F.3^-1*F.1*F.1*F.2;;
lfb := F.1^-1*F.1^-1*F.3*F.1*F.3^-1*F.1*F.3*F.1^-1*F.3^-1*F.1*F.1;;
lbb := F.1^-1*F.2^-1*F.1^-1*F.1^-1*F.3*F.1*F.2*F.1*F.3^-1*F.1^-1*F.3*F.1^-1*F.3*F.1^-1*F.3^-1*F.1*F.1;;
Q := F/Concatenation(rels,[mua*lba1, mub*lbb]);;
Print("H1: ", AbelianInvariants(Q), "\n");
S := SimplifiedFpGroup(Q);;
fg := FreeGeneratorsOfFpGroup(S);;
rl := RelatorsOfFpGroup(S);;
Print("simplified: ", Length(fg), " gens, ", Length(rl), " rels, total len ",
      Sum(rl, Length), "\n");
for i in [1..Length(fg)] do
  tab := CosetTableFromGensAndRels(fg, rl, [fg[i]] : max := 6000000, silent := true);
  if tab = fail then Print("cyclic <g",i,">: overflow\n");
  else Print("cyclic <g",i,">: index ", Length(tab[1]), "\n"); fi;
od;
tab := CosetTableFromGensAndRels(fg, rl, [] : max := 12000000, silent := true);
if tab = fail then Print("full: overflow at 12M\n");
else Print("full: |G| = ", Length(tab[1]), "\n"); fi;
QUIT;;
