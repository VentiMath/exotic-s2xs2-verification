  ok := IsConfluent(rws) and ForAll(reductions,IsOne);;
  PrintTo("direct_rws/n0_y1_p1_p1.certificate","knuth_bendix_return := ",attempt,";;\n","confluent := ",IsConfluent(rws),";;\n","generator_normal_forms := ",reductions,";;\n","certified_trivial := ",ok,";;\n");
