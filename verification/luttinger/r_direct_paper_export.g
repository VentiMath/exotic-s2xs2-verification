PrintTo("direct_rws/n1_y2_m1_m1.presentation","case := \"n1_y2_m1_m1\";;\n","ordering := \"fill_then_base\";;\n","free_generators := ",fg,";;\n","relators := ",rl,";;\n");
if Length(fg)=0 then
  PrintTo("direct_rws/n1_y2_m1_m1.certificate","certificate := \"Tietze_zero_generators\";;\n");
else
  rws := KBMAGRewritingSystem(H);;
  attempt := CALL_WITH_CATCH(KnuthBendix,[rws]);;
  reductions := List(GeneratorsOfGroup(FreeStructureOfRewritingSystem(rws)),
                     z -> ReducedForm(rws,z));;
  ok := IsConfluent(rws) and ForAll(reductions,IsOne);;
  PrintTo("direct_rws/n1_y2_m1_m1.certificate","knuth_bendix_return := ",attempt,";;\n","confluent := ",IsConfluent(rws),";;\n","generator_normal_forms := ",reductions,";;\n","certified_trivial := ",ok,";;\n");
  if ok then WriteRWS(rws,"direct_rws/n1_y2_m1_m1.rws");
  else all_ok := false; fi;
fi;
if not all_ok then Error("at least one export case did not certify trivial"); fi;
Print("ALL EIGHT EXPORTS CERTIFIED\n");
QUIT;;
