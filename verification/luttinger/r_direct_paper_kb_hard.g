if Length(fg)=0 then
  Print("  CERTIFIED TRIVIAL (Tietze)\n"); done := true;
else
  rws := KBMAGRewritingSystem(H);;
  attempt := CALL_WITH_CATCH(KnuthBendix,[rws]);;
  reductions := List(GeneratorsOfGroup(FreeStructureOfRewritingSystem(rws)),
