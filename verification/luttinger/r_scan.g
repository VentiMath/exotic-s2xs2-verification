mua := F.1^-1*F.1^-1*F.3*F.1*F.3^-1*F.1*F.3^-1*F.1*F.3;;
lfa := F.2^-1*F.1*F.2*F.1;;
lba1 := F.2;;
lba2 := F.1*F.2*F.1;;
mub := F.1^-1*F.1^-1*F.3*F.1*F.3^-1*F.1*F.2^-1*F.1^-1*F.2^-1*F.1^-1*F.3*F.1^-1*F.3^-1*F.1*F.1*F.2*F.1^-1*F.1^-1*F.3*F.1*F.3^-1*F.1*F.3*F.1^-1*F.3^-1*F.1*F.1*F.2;;
lfb := F.1^-1*F.1^-1*F.3*F.1*F.3^-1*F.1*F.3*F.1^-1*F.3^-1*F.1*F.1;;
lbb := F.1^-1*F.2^-1*F.1^-1*F.1^-1*F.3*F.1*F.2*F.1*F.3^-1*F.1^-1*F.3*F.1^-1*F.3*F.1^-1*F.3^-1*F.1*F.1;;
probe := function(w1, w2, tag)
  local Q, S, tab;
  Q := F/Concatenation(rels,[w1, w2]);
  if Length(AbelianInvariants(Q)) > 0 then
    Print(tag, ": H1 nonzero\n"); return;
  fi;
  S := SimplifiedFpGroup(Q);
  if Length(FreeGeneratorsOfFpGroup(S)) = 0 then
    Print(tag, ": TRIVIAL (Tietze)\n"); return;
  fi;
  tab := CosetTableFromGensAndRels(FreeGeneratorsOfFpGroup(S),
           RelatorsOfFpGroup(S), [] : max := 1000000, silent := true);
  if tab = fail then Print(tag, ": overflow\n");
  elif Length(tab[1]) = 1 then Print(tag, ": TRIVIAL\n");
  else Print(tag, ": |G| = ", Length(tab[1]), "\n"); fi;
end;;
for j in [-1,0,1] do for k in [-1,0,1] do
  probe(mua*lba1, mub*lbb*lfb^j*mub^k,
        Concatenation("beta j=",String(j)," k=",String(k)));
od; od;
for j in [-1,0,1] do for k in [-1,0,1] do
  probe(mua*lba1*lfa^j*mua^k, mub*lbb,
        Concatenation("alpha j=",String(j)," k=",String(k)));
od; od;
QUIT;;
